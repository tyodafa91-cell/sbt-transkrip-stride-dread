# Salin jadi .env LALU ISI. JANGAN PERNAH commit/kirim file .env asli.
# Semua akun = akun TESTNET khusus penelitian (tanpa uang asli). Buat dengan: cast wallet new
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/ISI_API_KEY_INFURA
ETHERSCAN_API_KEY=ISI_API_KEY_ETHERSCAN

# Peran yang MENGIRIM transaksi (butuh kunci + saldo Sepolia; Admin mengisi saldo dua lainnya otomatis)
PRIVATE_KEY=0xISI_KUNCI_ADMIN
ACCREDITOR_KEY=0xISI_KUNCI_ACCREDITOR
ISSUER_KEY=0xISI_KUNCI_ISSUER

# Peran yang cukup ALAMAT (tidak mengirim transaksi; verifier tidak butuh akun sama sekali)
HOLDER_ADDRESS=0xISI_ALAMAT_HOLDER
ATTACKER_ADDRESS=0xISI_ALAMAT_ATTACKER

# Opsional: saldo yang dikirim Admin ke Accreditor & Issuer saat deploy (default 0.01 ETH = 10000000000000000)
# FUND_WEI=10000000000000000
